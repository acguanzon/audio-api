# Generate a long random value. Never commit your real .env file.
AUDIO_API_KEY=replace-with-a-long-random-secret
PORT=8080
TOKEN_TTL_SECONDS=300
RATE_LIMIT_PER_HOUR=10
MAX_DURATION_SECONDS=1800
MAX_CONCURRENT_JOBS=1

# Optional: Base64-encoded Netscape-format YouTube cookies for servers that
# receive YouTube's "Sign in to confirm you're not a bot" response.
# Never commit or share real cookies.
# YTDLP_COOKIES_B64=
